+// The player's choice of video link: every preset's VTX made analog or digital (keeping its
+// power), or each as its file says. presetsBase keeps the presets as loaded.
+static void applyVideoMode() {
+    Lib &L = lib();
+    if (L.presetsBase.size() != L.presets.size()) L.presetsBase = L.presets;
+    const int m = L.settings.videoMode;
+    for (size_t i = 0; i < L.presets.size(); i++) {
+        DronePreset p = L.presetsBase[i];
+        if (m >= 0 && p.vtx.digital != (m == 1)) {
+            p.vtx.digital = m == 1;
+            if (m == 1) {
+                p.vtx.height = 1080;
+                p.vtx.fps = 60.0f;
+                p.vtx.freezes = true;
+                p.vtx.sensitivityDbm = -98.0f;
+                p.camera.aspect = 16.0f / 9.0f;
+            } else {
+                p.camera.aspect = 4.0f / 3.0f;
+            }
+        }
+        L.presets[i] = p;
+    }
+}
