+FPV_API void fpv_video_set_mode(int mode) {
+    Lib &L = lib();
+    std::lock_guard<std::recursive_mutex> lock(L.mutex);
+    L.settings.videoMode = mode < 0 ? -1 : mode > 0 ? 1 : 0;
+    if (L.settings.videoMode >= 0) L.settings.osdStyle = L.settings.videoMode ? FPV_OSD_STYLE_HD : FPV_OSD_STYLE_ANALOG;
+    if (!L.initialized) return;
+    applyVideoMode();
+    if (L.droneExists) {
+        const DronePreset p = currentPreset();
+        L.runner.call([&] { L.flight.applyPreset(p); });
+    }
+    saveSettings();
+}
+
+FPV_API int fpv_video_get_mode(void) {
+    Lib &L = lib();
+    std::lock_guard<std::recursive_mutex> lock(L.mutex);
+    return L.settings.videoMode;
+}
