+FPV_API void fpv_camera_set_uptilt(float degrees) {
+    Lib &L = lib();
+    std::lock_guard<std::recursive_mutex> lock(L.mutex);
+    L.settings.cameraUptilt = degrees < 0 ? -1.0f : std::clamp(degrees, 0.0f, 70.0f);
+    if (L.initialized) saveSettings();
+}
+
+FPV_API float fpv_camera_get_uptilt(void) {
+    Lib &L = lib();
+    std::lock_guard<std::recursive_mutex> lock(L.mutex);
+    return L.settings.cameraUptilt >= 0 ? L.settings.cameraUptilt : currentPreset().camera.uptiltDeg;
+}
