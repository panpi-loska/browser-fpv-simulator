 void Overlay::rebuildFonts() {
     ImGuiIO &io = ImGui::GetIO();
+    // the Betaflight OSD font (3 screen pixels to one of its pixels when baked), and ImGui's own font
+    // merged in for what it lacks (lower case maps to its capitals; accents, symbols)
     ImFontConfig cfg;
-    cfg.SizePixels = 32.0f;  // baked large, drawn at 16 * ui_scale
-    io.Fonts->AddFontDefaultVector(&cfg);
+    cfg.FontDataOwnedByAtlas = false;
+    cfg.PixelSnapH = true;
+    cfg.OversampleH = cfg.OversampleV = 1;
+    io.Fonts->AddFontFromMemoryTTF((void *)kRetroOsdTtf, (int)sizeof kRetroOsdTtf, 36.0f, &cfg);
+    ImFontConfig merge;
+    merge.MergeMode = true;
+    merge.SizePixels = 30.0f;
+    io.Fonts->AddFontDefaultVector(&merge);
     unsigned char *px = nullptr;
     io.Fonts->GetTexDataAsRGBA32(&px, &m_fontW, &m_fontH);
     m_fontPixels.assign(px, px + (size_t)m_fontW * m_fontH * 4);
     io.Fonts->SetTexID((ImTextureID)FPV_TEXTURE_OVERLAY_FONT);
-    ImGui::GetStyle().FontSizeBase = 16.0f;
+    ImGui::GetStyle().FontSizeBase = 18.0f;
     m_fontRevision++;
 }
 
